# Your own settings for docker compose (T142): copy this file to .env and fill it in. .env stays out of git.
# A free hobby key from https://www.thunderforest.com for the map's tiles. Or leave it empty and add it, with
# any other map keys, in the app's Admin panel (API keys).
THUNDERFOREST_KEY=
# Where Requests start until you click elsewhere: somewhere public near you is fine.
HOME_LATITUDE=
HOME_LONGITUDE=
# The database's password, inside Docker only.
DB_PASSWORD=wend-your-way
