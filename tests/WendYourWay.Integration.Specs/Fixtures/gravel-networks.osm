<!--
  T072 Gravel networks fixture, near Box Hill (the features are invented; only the place is real).
  Ways end to end, running east along one line:
    500 a track, nodes 1-3, about 1.4 km
    501 a residential road, nodes 3-4, about 70 m: short enough to join 500 and 502
    502 a track, nodes 4-6, about 1.4 km
    503 a residential road, nodes 6-7, about 140 m: a road link, joining 502 and 504 (T074)
    504 a track, nodes 7-8, about 0.7 km
    505 a footway, nodes 8-9, about 0.7 km: a bike may not use it
  And to the north and south, each reached only by a link that doesn't count:
    510 a track, nodes 20-21, about 0.7 km, 1.1 km north of node 1
    511 a residential road, nodes 1-22-20, about 1.1 km: longer than a road link
    512 a track, nodes 30-31, about 0.7 km, 670 m south of node 5
    513 a primary road, nodes 5-30, about 670 m: a Main Road, never a road link
  osm2pgsql needs all nodes before all ways, each sorted by ID.
-->
<osm version="0.6" generator="hand">
  <node id="1" lat="51.2500" lon="-0.4000"/>
  <node id="2" lat="51.2500" lon="-0.3900"/>
  <node id="3" lat="51.2500" lon="-0.3800"/>
