  <node id="21" lat="51.2600" lon="-0.3900"/>
  <node id="22" lat="51.2550" lon="-0.4000"/>
  <node id="30" lat="51.2440" lon="-0.3690"/>
  <node id="31" lat="51.2440" lon="-0.3590"/>
  <way id="500">
    <nd ref="1"/><nd ref="2"/><nd ref="3"/>
    <tag k="highway" v="track"/>
  </way>
  <way id="501">
    <nd ref="3"/><nd ref="4"/>
    <tag k="highway" v="residential"/>
  </way>
  <way id="502">
