<?xml version="1.0" encoding="UTF-8"?>
<!--
  T004 topology fixture: each awkward case in its own corner of the map, on Hampstead Heath
  (the ways are invented; only the place is real).
  osm2pgsql needs all nodes before all ways, each sorted by ID, as in real extracts.
  0.001° of longitude here is about 69 m; 0.001° of latitude about 111 m.
-->
<osm version="0.6" generator="hand">
  <node id="1" lat="51.5600" lon="-0.1650"/>
  <node id="2" lat="51.5600" lon="-0.1640"/>
  <node id="3" lat="51.5600" lon="-0.1630"/>
  <node id="4" lat="51.5610" lon="-0.1640"/>
  <node id="5" lat="51.5590" lon="-0.1640"/>
  <node id="6" lat="51.5605" lon="-0.1635"/>
  <node id="7" lat="51.5595" lon="-0.1635"/>
  <node id="8" lat="51.5620" lon="-0.1650"/>
  <node id="9" lat="51.5625" lon="-0.1645"/>
  <node id="10" lat="51.5620" lon="-0.1640"/>
  <node id="11" lat="51.5630" lon="-0.1650"/>
  <node id="12" lat="51.5630" lon="-0.1640"/>
  <node id="13" lat="51.5630" lon="-0.1630"/>
  <node id="17" lat="51.5635" lon="-0.1640"/>
  <node id="18" lat="51.5635" lon="-0.1630"/>
  <node id="19" lat="51.5640" lon="-0.1650"/>
  <node id="20" lat="51.5640" lon="-0.1640"/>
  <node id="21" lat="51.5640" lon="-0.1630"/>
  <node id="22" lat="51.5645" lon="-0.1640"/>
  <node id="23" lat="51.5650" lon="-0.1650"/>
  <node id="24" lat="51.5650" lon="-0.1640"/>
  <node id="25" lat="51.5660" lon="-0.1650"/>
  <node id="26" lat="51.5660" lon="-0.1640"/>
  <node id="27" lat="51.5665" lon="-0.1645"/>
  <node id="28" lat="51.5600" lon="-0.1620"/>
  <node id="30" lat="51.5670" lon="-0.1650"/>
  <node id="31" lat="51.5670" lon="-0.1640"/>
  <node id="32" lat="51.5675" lon="-0.1635"/>
  <node id="33" lat="51.5680" lon="-0.1640"/>
  <node id="34" lat="51.5680" lon="-0.1650"/>
  <node id="35" lat="51.5665" lon="-0.1640"/>
  <node id="36" lat="51.5665" lon="-0.1650"/>
  <node id="40" lat="51.5690" lon="-0.1660"/>
  <node id="41" lat="51.5690" lon="-0.1650"/>
  <node id="42" lat="51.5695" lon="-0.1640"/>
  <node id="43" lat="51.5685" lon="-0.1640"/>
  <!-- node 99 is deliberately missing, as at the edge of an extract -->

  <!-- A crossing at a shared node: footway 10 (1-2-3) and road 11 (4-2-5) meet at 2 -->
  <way id="10"><nd ref="1"/><nd ref="2"/><nd ref="3"/><tag k="highway" v="footway"/></way>
  <way id="11"><nd ref="4"/><nd ref="2"/><nd ref="5"/><tag k="highway" v="residential"/></way>

  <!-- A bridge: path 30 (6-7) crosses footway 10 between 2 and 3 without sharing a node -->
  <way id="30"><nd ref="6"/><nd ref="7"/><tag k="highway" v="path"/><tag k="bridge" v="yes"/><tag k="layer" v="1"/></way>

  <!-- A closed way: footway 40 (8-9-10-8) round a pond, joined to node 1 by footway 41 -->
  <way id="40"><nd ref="8"/><nd ref="9"/><nd ref="10"/><nd ref="8"/><tag k="highway" v="footway"/></way>
  <way id="41"><nd ref="1"/><nd ref="8"/><tag k="highway" v="footway"/></way>

  <!-- A building outline 61 shares node 12 with footway 60 (11-12-13): not a junction -->
  <way id="60"><nd ref="11"/><nd ref="12"/><nd ref="13"/><tag k="highway" v="footway"/></way>
  <way id="61"><nd ref="12"/><nd ref="17"/><nd ref="18"/><nd ref="12"/><tag k="building" v="yes"/></way>

  <!-- A private drive 63 (20-22) joins footway 62 (19-20-21) at 20: still a junction -->
  <way id="62"><nd ref="19"/><nd ref="20"/><nd ref="21"/><tag k="highway" v="footway"/></way>
  <way id="63"><nd ref="20"/><nd ref="22"/><tag k="highway" v="service"/><tag k="access" v="private"/></way>

  <!-- Not routable: a road still being built, and a service yard drawn as an area (motorways and
       pedestrian squares are kept since T035) -->
  <way id="70"><nd ref="23"/><nd ref="24"/><tag k="highway" v="construction"/></way>
  <way id="71"><nd ref="25"/><nd ref="26"/><nd ref="27"/><nd ref="25"/><tag k="highway" v="service"/><tag k="area" v="yes"/></way>

  <!-- A track 80 (3-99-28) whose middle node 99 is missing from the extract -->
  <way id="80"><nd ref="3"/><nd ref="99"/><nd ref="28"/><tag k="highway" v="track"/></way>

  <!-- A closed way 90 (30-31-32-33-34-30) already joined at two points (30 by path 92, 31 by
       path 91): it is cut only at those junctions, not also at its middle (32) -->
  <way id="90"><nd ref="30"/><nd ref="31"/><nd ref="32"/><nd ref="33"/><nd ref="34"/><nd ref="30"/><tag k="highway" v="footway"/></way>
  <way id="91"><nd ref="31"/><nd ref="35"/><tag k="highway" v="path"/></way>
  <way id="92"><nd ref="30"/><nd ref="36"/><tag k="highway" v="path"/></way>

  <!-- A lollipop: footway 100 (40-41-42-43-41) runs up a stick and round a turning loop back
       to 41. Its only junction is with itself, so the loop is cut at its middle (42) -->
  <way id="100"><nd ref="40"/><nd ref="41"/><nd ref="42"/><nd ref="43"/><nd ref="41"/><tag k="highway" v="footway"/></way>
</osm>
