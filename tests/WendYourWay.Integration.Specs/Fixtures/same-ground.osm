  <!-- A road 200 (1-2-3) running east, with a side street 201 (2-4) going north from it -->
  <way id="200"><nd ref="1"/><nd ref="2"/><nd ref="3"/><tag k="highway" v="residential"/></way>
  <way id="201"><nd ref="2"/><nd ref="4"/><tag k="highway" v="residential"/></way>

  <!-- Its two pavements, about 6 m either side, drawn as plain footways (no sidewalk tag) -->
  <way id="210"><nd ref="10"/><nd ref="11"/><tag k="highway" v="footway"/></way>
  <way id="211"><nd ref="12"/><nd ref="13"/><tag k="highway" v="footway"/></way>

  <!-- A one-way cycle track 212 (14-15) about 10 m beside the side street -->
  <way id="212"><nd ref="14"/><nd ref="15"/><tag k="highway" v="cycleway"/><tag k="oneway" v="yes"/></way>

  <!-- A footway 220 (16-17) parallel to the road but 45 m from it -->
  <way id="220"><nd ref="16"/><nd ref="17"/><tag k="highway" v="footway"/></way>

  <!-- A pavement 221 (25-26) about 6 m beside footway 220, its road not drawn -->
  <way id="221"><nd ref="25"/><nd ref="26"/><tag k="highway" v="footway"/><tag k="footway" v="sidewalk"/></way>

  <!-- A dirt path 230 (23-24) about 7 m beside the road: 35 m of it beside its west
       Segment (1-2), 125 m beside its east one (2-3) -->
  <way id="230"><nd ref="23"/><nd ref="24"/><tag k="highway" v="path"/><tag k="surface" v="dirt"/></way>

  <!-- A path 231 (31-32) with no surface tag, about 8 m beside the road's east Segment for 41 m -->
  <way id="231"><nd ref="31"/><nd ref="32"/><tag k="highway" v="path"/></way>

  <!-- A footway 240 (18-19) crossing the road at right angles: 13 m long, all of it near the road -->
  <way id="240"><nd ref="18"/><nd ref="19"/><tag k="highway" v="footway"/></way>

  <!-- A footway 250 (20-21-22) beside the road for 35 m, then off across a park for 150 m -->
  <way id="250"><nd ref="20"/><nd ref="21"/><nd ref="22"/><tag k="highway" v="footway"/></way>

  <!-- An alley 260 (27-28) and a footway 261 (29-30) about 6 m beside it -->
  <way id="260"><nd ref="27"/><nd ref="28"/><tag k="highway" v="service"/><tag k="service" v="alley"/></way>
  <way id="261"><nd ref="29"/><nd ref="30"/><tag k="highway" v="footway"/></way>

  <!-- Big and fast roads (T199, #203), east of the rest (ways in ID order, as osm2pgsql needs):
       300 (40-41), one carriageway of a three-lane 50 mph dual carriageway: an asphalt cycle path 310 (42-43) 16 m
         beside it, a footway 311 (44-45) 30 m from it;
       301 (46-47), a 60 mph lane: a dirt bridleway 320 (48-49) 9 m beside it;
       302 (50-51), a lane with no speed tagged: a dirt path 330 (52-53) 9 m beside it;
       303 (54-55), an ordinary street: an asphalt footway 340 (56-57) 16 m from it. -->
  <way id="300"><nd ref="40"/><nd ref="41"/><tag k="highway" v="trunk"/><tag k="oneway" v="yes"/><tag k="lanes" v="3"/><tag k="maxspeed" v="50 mph"/><tag k="dual_carriageway" v="yes"/></way>
  <way id="301"><nd ref="46"/><nd ref="47"/><tag k="highway" v="tertiary"/><tag k="maxspeed" v="60 mph"/></way>
  <way id="302"><nd ref="50"/><nd ref="51"/><tag k="highway" v="tertiary"/></way>
  <way id="303"><nd ref="54"/><nd ref="55"/><tag k="highway" v="residential"/></way>
  <way id="310"><nd ref="42"/><nd ref="43"/><tag k="highway" v="cycleway"/><tag k="surface" v="asphalt"/></way>
  <way id="311"><nd ref="44"/><nd ref="45"/><tag k="highway" v="footway"/></way>
  <way id="320"><nd ref="48"/><nd ref="49"/><tag k="highway" v="bridleway"/><tag k="surface" v="dirt"/></way>
  <way id="330"><nd ref="52"/><nd ref="53"/><tag k="highway" v="path"/><tag k="surface" v="dirt"/></way>
  <way id="340"><nd ref="56"/><nd ref="57"/><tag k="highway" v="footway"/><tag k="surface" v="asphalt"/></way>
</osm>
