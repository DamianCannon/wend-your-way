<?xml version="1.0" encoding="UTF-8"?>
<!--
  Main Road fixture: a primary road with a pavement 5.5 m to its north, a residential street off
  it, and a footpath across a field, near Richmond (the ways are invented; only the place is
  real). osm2pgsql needs all nodes before all ways, each sorted by ID.
  0.00001° of latitude here is about 1.11 m.
-->
<osm version="0.6" generator="hand">
  <node id="1" lat="51.4600" lon="-0.3050"/>
  <node id="2" lat="51.4600" lon="-0.3020"/>
  <node id="3" lat="51.4600" lon="-0.2990"/>
  <node id="4" lat="51.4630" lon="-0.3020"/>
  <node id="5" lat="51.4570" lon="-0.3020"/>
  <node id="10" lat="51.46005" lon="-0.3050"/>
  <node id="11" lat="51.46005" lon="-0.2990"/>
  <way id="100">
    <nd ref="1"/><nd ref="2"/><nd ref="3"/>
    <tag k="highway" v="primary"/>
    <tag k="name" v="The Main Road"/>
  </way>
  <way id="101">
    <nd ref="2"/><nd ref="4"/>
    <tag k="highway" v="residential"/>
  </way>
  <way id="102">
    <nd ref="2"/><nd ref="5"/>
    <tag k="highway" v="footway"/>
    <tag k="surface" v="grass"/>
  </way>
  <way id="110">
    <nd ref="10"/><nd ref="11"/>
    <tag k="highway" v="footway"/>
    <tag k="footway" v="sidewalk"/>
  </way>
</osm>
