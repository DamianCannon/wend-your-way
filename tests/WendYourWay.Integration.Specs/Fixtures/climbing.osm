<?xml version="1.0" encoding="UTF-8"?>
<!--
  T049 Climbing fixture, near Box Hill (invented; only the place is real), on the terrain tile in
  terrain/TQ15_part.asc: 1 km square, ground rising 1 m in every 10 m eastwards and a valley 20 m
  deep running east-west, flat-bottomed for 50 m either side of its line. Footway 100 runs 300 m
  east up the slope; 102 runs 400 m north across the valley; 103 is a bridge over it and 104 a
  tunnel under it, both laid the same way. Generated by a script; osm2pgsql needs all nodes before
  all ways, each sorted by ID.
-->
<osm version="0.6" generator="hand">
  <node id="1" lat="51.2479397" lon="-0.3221762"/>
  <node id="2" lat="51.2478780" lon="-0.3178798"/>
  <node id="3" lat="51.2506155" lon="-0.3206458"/>
  <node id="4" lat="51.2542107" lon="-0.3205149"/>
  <node id="5" lat="51.2505744" lon="-0.3177815"/>
  <node id="6" lat="51.2541696" lon="-0.3176502"/>
  <node id="7" lat="51.2505332" lon="-0.3149171"/>
  <node id="8" lat="51.2541284" lon="-0.3147856"/>
  <way id="100"><nd ref="1"/><nd ref="2"/><tag k="highway" v="footway"/></way>
  <way id="102"><nd ref="3"/><nd ref="4"/><tag k="highway" v="footway"/></way>
  <way id="103"><nd ref="5"/><nd ref="6"/><tag k="highway" v="footway"/><tag k="bridge" v="yes"/></way>
  <way id="104"><nd ref="7"/><nd ref="8"/><tag k="highway" v="footway"/><tag k="tunnel" v="yes"/></way>
</osm>
