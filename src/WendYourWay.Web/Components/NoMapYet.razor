@using WendYourWay.Web.Planning
@inject IPracticeOffer Offer
@inject PlannerSettings Settings
@* No map of your own yet (T162, #166; user chose "Offered when no map"): said, and the practice map
   (T161) offered, switched to in the same window (T163); in a browser, how to open it. *@

@if (_noMap)
{
    <div class="no-map" role="status">
        <p>There's no map of your own yet, so no Loops can be found here. Build your region's map (Getting started in the README says how: a county takes minutes), or try Wend Your Way first on the practice map of Richmond Park.</p>
        <SwitchMap Label="Try the practice map">
            <NotInWindow><p class="open-how">To try it: @Offer.HowToOpen.</p></NotInWindow>
        </SwitchMap>
    </div>
}

@code {
    private bool _noMap;

    protected override async Task OnInitializedAsync()
    {
        if (!Settings.Practice) _noMap = await Offer.NoMapOfYourOwnAsync();
    }
}
