@* A key to the map (T177, #181): only what's on screen, as the map says; collapsible, remembered by the map. *@

@if (_sections.Count > 0)
{
    <aside class="map-key" aria-label="Map key">
        <button type="button" class="toggle" aria-expanded="@(Collapsed ? "false" : "true")" @onclick="() => OnCollapsedChanged.InvokeAsync(!Collapsed)">Key</button>
        @if (!Collapsed)
        {
            @foreach (var section in _sections)
            {
                @if (section.Entries.Count > 1)
                {
                    <h3>@section.Title</h3>
                }
                <ul>
                    @foreach (var entry in section.Entries)
                    {
                        <li><span class="swatch @entry.Swatch" aria-hidden="true"></span>@entry.Label</li>
                    }
                </ul>
            }
        }
    </aside>
}

@code {
    /// <summary>One line of the key: what it's called, and the swatch (app.css's <c>.swatch.&lt;name&gt;</c>) drawn beside it.</summary>
    public sealed record KeyEntry(string Label, string Swatch);

    /// <summary>
    /// What one thing on the map looks like: <paramref name="Shows"/> is the map's own word for it being on
    /// screen (an overlay's name in the switcher, or the Loop's and Outing's parts), its entries headed by
    /// <paramref name="Title"/> when there's more than one.
    /// </summary>
    public sealed record KeySection(string Shows, string Title, IReadOnlyList<KeyEntry> Entries);

    private static KeySection One(string shows, string label, string swatch) => new(shows, label, [new KeyEntry(label, swatch)]);

    /// <summary>
    /// Everything the key can say, in its order: single entries first (the route's, then the overlays'), then
    /// the headed groups below them, for a visual break (user, 2026-11-22).
    /// </summary>
    public static readonly IReadOnlyList<KeySection> Sections =
    [
        One("loop", "The Loop", "loop"),
        One("stops", "A stop on the way", "stop"),
        One("avoids", "Avoided", "avoid"),
        One("map-gaps", "A gap in the map, crossed: check it's passable", "map-gap"),
        One("possible-gaps", "A possible gap in the map", "possible-gap"),
        One("not-on-map", "Not on the map", "not-on-map"),
        One("blocked", "Never used (blocked)", "blocked"),
        One("Open access land", "Open access land", "access-land"),
        One("OS paths", "OS paths", "os-paths"),
        One("Gravel hotspots", "Gravel hotspots", "hotspot"),
        One("Car parks", "Car parks", "car-park"),
        new("outing", "The Outing", [new("Off-road", "ground-off-road"), new("Traffic-free", "ground-traffic-free"), new("Connector", "ground-connector"), new("Gap", "outing-gap")]),
        new("Off-road networks", "Off-road networks", [new("Under 10 km", "off-road-1"), new("10–30 km", "off-road-2"), new("30–100 km", "off-road-3"), new("100–300 km", "off-road-4"), new("Over 300 km", "off-road-5")]),
        new("Signed trails", "Signed trails", [new("International", "trail-international"), new("National", "trail-national"), new("Regional", "trail-regional"), new("Local", "trail-local")]),
        new("Cafés and toilets", "Cafés and toilets", [new("Café", "cafe"), new("Toilets", "toilets")]),
    ];

    /// <summary>What's on screen, in the map's words.</summary>
    [Parameter] public IReadOnlyCollection<string> Shown { get; set; } = [];

    /// <summary>Whether only its heading shows.</summary>
    [Parameter] public bool Collapsed { get; set; }

    /// <summary>Collapsed or opened by the user.</summary>
    [Parameter] public EventCallback<bool> OnCollapsedChanged { get; set; }

    private IReadOnlyList<KeySection> _sections = [];

    protected override void OnParametersSet() => _sections = [.. Sections.Where(s => Shown.Contains(s.Shows))];
}
